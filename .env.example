# رابط الاتصال بقاعدة بيانات Neon PostgreSQL
DATABASE_URL=

# مفتاح سري لتوقيع جلسات تسجيل الدخول (استخدم قيمة عشوائية طويلة)
# يمكنك توليده عبر: openssl rand -base64 32
AUTH_SECRET=

# بيانات حساب المدير الأول (يُستخدم فقط عند تشغيل pnpm db:seed)
SEED_ADMIN_EMAIL=admin@school.com
SEED_ADMIN_PASSWORD=Admin@12345

# (لاحقًا) رابط تخزين الملفات - Vercel Blob
BLOB_READ_WRITE_TOKEN=
